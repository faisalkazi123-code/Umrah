# Server
PORT=3001
# Comma-separated list of allowed browser origins for CORS (leave empty for same-origin only)
CORS_ORIGINS=http://localhost:5173
# PostgreSQL connection string
DATABASE_URL=postgres://umrah:umrah@localhost:5432/umrah
# Set to "true" behind an HTTPS proxy so guest cookies are marked Secure
COOKIE_SECURE=false
# Optional: database for the API integration tests (skipped when unset). It is WIPED on every test run.
TEST_DATABASE_URL=
